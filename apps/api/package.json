{
  "name": "@cig/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "concurrently \"tsx watch src/index.ts\" \"tsx watch src/worker.ts\"",
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@cig/db": "*",
    "@cig/types": "*",
    "@cig/utils": "*",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.51.4",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.1",
    "tsx": "^4.19.4",
    "typescript": "^5.7.3",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.21",
    "@types/uuid": "^10.0.0",
    "concurrently": "^8.2.2"
  }
