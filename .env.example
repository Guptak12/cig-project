# Secrets & Database (Neon Postgres / Local Postgres)
JWT_SECRET=super-secret-jwt-key-for-local-dev-12345
DATABASE_URL=postgresql://cig:cig_secret@localhost:5432/cig_db
# For Neon serverless postgres: postgresql://username:password@ep-xyz.neon.tech/neondb?sslmode=require

# Queue & Cache (Upstash Redis / Local Redis)
REDIS_URL=redis://localhost:6379
# For Upstash serverless redis: rediss://default:token@engaged-ray.upstash.io:6379

# Storage (Cloudflare R2 / AWS S3 / Mock Storage)
# Set S3_ENDPOINT for Cloudflare R2 (10 GB free forever, $0 egress fees)
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=<your-r2-or-s3-access-key>
S3_SECRET_ACCESS_KEY=<your-r2-or-s3-secret-key>
S3_BUCKET_ORIGINALS=cig-media-originals
S3_BUCKET_THUMBS=cig-media-thumbs

# AI & Facial Recognition (Local AI Engine vs AWS Rekognition)
# Set USE_LOCAL_AI=true to run 100% AWS-free with zero cloud AI charges
USE_LOCAL_AI=true
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=mock-access-key-id
AWS_SECRET_ACCESS_KEY=mock-secret-access-key
REKOGNITION_COLLECTION_ID=cig-faces

# URLs & Ports
CDN_URL=https://<your-r2-public-domain-or-cloudfront>.cloudfront.net
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_CDN_URL=http://localhost:4000/mock-s3-view
PORT=4000
